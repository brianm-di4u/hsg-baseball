{
  "_doc": "Canonical review frames for tools/shots-review.mjs. Setup steps are [op, ...args]: game {newGame opts; defaults: seeded paused exhibition, Lakeside home, Hot Springs away, the user batting at the home park}, act name ...args (window.__game.act), until phase [maxTicks] (step one tick at a time until the game phase), step n (sim ticks, 1/60 s), title t (the title flyover at t seconds), replay t (the replay view at t seconds). Crops (desktop only) are close-ups through __game.act('camLook', target, width ft, pitch, yaw): target is a role (pitcher, catcher, 1B … RF, batter, runner1-3, ump) with an optional part (:head, :hands, :feet, :glove). Strips are 8 frames 'every' sim ticks apart; a strip with 'look' frames one actor through the close camera (the 3D frame alone), so motion reads at size.",
  "clock": 12345,
  "shots": [
    { "id": "R01", "title": "Title flyover, home park", "cats": ["environment", "lighting"],
      "setup": [["title", 14]] },
    { "id": "R02", "title": "Batting: catcher's-eye camera before the pitch", "cats": ["characters", "ui", "readability"], "mobile": true,
      "setup": [["game", { "seed": 7 }]],
      "crops": [{ "target": "batter", "width": 7.5, "yaw": 0.6 }, { "target": "batter:head", "width": 1.6, "yaw": 0.5, "pitch": 0.05 }, { "target": "batter:hands", "width": 2.4, "yaw": 0.9, "pitch": 0.1 }, { "target": "pitcher", "width": 7.5, "yaw": 0.4 }] },
    { "id": "R03", "title": "Pitch delivery (batting camera)", "cats": ["animation", "characters"],
      "setup": [["game", { "seed": 7 }], ["act", "aiPitch", { "x": 0.3, "z": 2.6 }], ["until", "windup"], ["step", 30]],
      "strip": { "every": 8, "frames": 8, "look": { "target": "pitcher", "width": 8.5, "yaw": 1.2 } },
      "crops": [{ "target": "pitcher", "width": 7.5, "yaw": 0.3 }] },
    { "id": "R04", "title": "Swing through contact", "cats": ["animation", "readability"],
      "setup": [["game", { "seed": 7 }], ["act", "contact", { "ev": 70, "la": 60, "spray": 80 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "flight"], ["act", "swingAt", 0], ["step", 2]],
      "strip": { "every": 4, "frames": 8, "look": { "target": "batter", "width": 9, "yaw": 0.9 } },
      "crops": [{ "target": "batter", "width": 7.5, "yaw": 1.2 }] },
    { "id": "R05", "title": "Pitching: center-field camera with batter, catcher and umpire", "cats": ["characters", "ui", "readability"], "mobile": true,
      "setup": [["game", { "seed": 7, "user": "home" }]],
      "crops": [{ "target": "catcher", "width": 6.5, "yaw": 0.5 }, { "target": "ump", "width": 7.5, "yaw": 0.4 }, { "target": "ump:head", "width": 1.6, "yaw": 0.4 }, { "target": "batter", "width": 7.5, "yaw": -0.6, "tag": "front" }, { "target": "batter:feet", "width": 2.6, "yaw": 0.3, "pitch": 0.25 }] },
    { "id": "R06", "title": "Pitch in flight, center-field camera", "cats": ["readability", "animation"],
      "setup": [["game", { "seed": 7, "user": "home" }], ["act", "throw", { "type": "FB", "x": -0.4, "z": 2.2, "exact": true }], ["until", "flight"], ["step", 10]],
      "crops": [{ "target": "catcher:glove", "width": 2.5, "yaw": 0.6, "pitch": 0.15 }] },
    { "id": "R07", "title": "Ground ball to short: fielders break", "cats": ["animation", "characters", "readability"], "mobile": true,
      "setup": [["game", { "seed": 7 }], ["act", "contact", { "ev": 88, "la": -4, "spray": -12 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["step", 40]],
      "strip": { "every": 6, "frames": 8, "look": { "target": "SS", "width": 9, "yaw": 0.8 } },
      "crops": [{ "target": "SS", "width": 7.5, "yaw": 0.6 }, { "target": "batter", "width": 7.5, "yaw": 1.3, "tag": "runner" }] },
    { "id": "R08", "title": "Line drive in the gap: outfield chase", "cats": ["animation", "environment"],
      "setup": [["game", { "seed": 7 }], ["act", "contact", { "ev": 92, "la": 14, "spray": 18 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["step", 70]],
      "strip": { "every": 10, "frames": 8 },
      "crops": [{ "target": "CF", "width": 7.5, "yaw": 0.5 }] },
    { "id": "R09", "title": "Fly ball caught in left", "cats": ["animation", "characters"],
      "setup": [["game", { "seed": 7 }], ["act", "contact", { "ev": 90, "la": 34, "spray": -25 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["step", 200]],
      "crops": [{ "target": "LF", "width": 7.5, "yaw": 0.5 }] },
    { "id": "R10", "title": "Home run trot", "cats": ["characters", "animation", "environment"], "mobile": true,
      "setup": [["game", { "seed": 7 }], ["act", "contact", { "ev": 104, "la": 28, "spray": -12 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["step", 240]],
      "strip": { "every": 6, "frames": 8, "look": { "target": "batter", "width": 9, "yaw": 1.4 } },
      "crops": [{ "target": "batter", "width": 7.5, "yaw": 0.5, "tag": "trot" }] },
    { "id": "R11", "title": "Replay angle, first-base side", "cats": ["environment", "animation"],
      "setup": [["game", { "seed": 7 }], ["act", "contact", { "ev": 88, "la": -4, "spray": -12 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["act", "skip"], ["until", "pre", 1500], ["replay", 1.2]],
      "strip": { "replayFrom": 0.4, "step": 0.25, "frames": 8 } },
    { "id": "R12", "title": "Night final at Majestic Park, pitch in flight", "cats": ["lighting", "environment"], "mobile": true,
      "setup": [["game", { "seed": 5, "park": "majestic", "home": "lakeside", "away": "lake-hamilton", "night": true }], ["act", "aiPitch", { "x": -0.4, "z": 2.2 }], ["until", "flight"], ["step", 12]],
      "crops": [{ "target": "pitcher", "width": 7.5, "yaw": 0.5 }] },
    { "id": "R13", "title": "Night field view at Majestic Park", "cats": ["lighting", "environment"],
      "setup": [["game", { "seed": 5, "park": "majestic", "home": "lakeside", "away": "lake-hamilton", "night": true }], ["act", "contact", { "ev": 95, "la": 22, "spray": -25 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["step", 110]] },
    { "id": "R14", "title": "Historic park, golden afternoon, pitching camera", "cats": ["environment", "lighting", "characters"],
      "setup": [["game", { "mode": "spring", "seed": 3, "user": "home" }]],
      "crops": [{ "target": "batter", "width": 7.5, "yaw": -0.5 }] },
    { "id": "R15", "title": "Historic park: deep fly to right center", "cats": ["environment", "lighting"],
      "setup": [["game", { "mode": "spring", "seed": 3, "user": "away" }], ["act", "contact", { "ev": 104, "la": 27, "spray": 30 }], ["act", "aiPitch", { "x": 0, "z": 2.5 }], ["until", "play"], ["step", 150]] },
    { "id": "R16", "title": "Runners on, batting camera (lead-offs)", "cats": ["characters", "readability"],
      "setup": [["game", { "seed": 11, "situation": { "bases": [true, true, false], "outs": 1 } }]],
      "crops": [{ "target": "runner1", "width": 7.5, "yaw": 0.6 }, { "target": "1B", "width": 7.5, "yaw": 0.4 }] },
    { "id": "R17", "title": "Majestic Park by day, pitching camera", "cats": ["environment", "characters"],
      "setup": [["game", { "seed": 3, "park": "majestic", "home": "lake-hamilton", "away": "jessieville", "user": "home" }]],
      "crops": [{ "target": "pitcher", "width": 7.5, "yaw": 2.6, "tag": "back" }, { "target": "pitcher:hands", "width": 2.4, "yaw": 0.8 }] }
  ]
}
